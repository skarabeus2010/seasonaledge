{#
  scripts/templates/daily_report.html.j2

  SeasonAlpha Daily Morning Briefing — Jinja2-Template.

  HTML-Email-Standards: Table-based, inline CSS, max 600px, Dark Mode V3 Ultra.

  Context (aus shared/daily_report.build_daily_context):
    report_date         "2026-05-19"
    report_time         "2026-05-19 06:00 UTC"
    target_display      "Mo 19. Mai 2026"
    target_tdom         int (1-23)
    core_list           list[dict]  ← Sektion 1 (Kernliste / Markt-Überblick, score-sortiert)
    etfs                list[dict]  ← Sektion 2a (Top-ETFs, score-sortiert)
    stocks              list[dict]  ← Sektion 2b (Top-Aktien, score-sortiert)
    watchlist           list[dict]  ← Sektion 2c (persönliche Watchlist, score-sortiert)
    events              list[dict]  ← Sektion 3 (FOMC, OPEX, Earnings, Feiertage)
    strategies          list[dict]  ← Sektion 4 (aktive Saisonal-Strategien)
    rotation            dict        ← Sektion 5 (Sektor-Rotation)
    unsubscribe_url     str (pro Recipient mit ?type=daily)
    dashboard_url       str

  Signal-Row-Felder (core_list / etfs / stocks / watchlist):
    ticker, name, price_close (float|None), change_pct (float|None), price_date,
    lbr_daily (float|None), lbr_weekly (float|None)   # LBR-Fastline: >0 bullish, <0 bearish
    rsi_daily (float|None), rsi_weekly (float|None)    # 0–100
    score (int)        # technischer LBR/RSI-Score
    mw_score (int|None) # Saisonal-Score 0–4 (Multi-Window-TDOM), Primär-Sortierung
#}<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>SeasonAlpha — Morning Briefing {{ target_display }}</title>
  <style>
    /* Klassen statt langer Inline-Styles → Mail bleibt klein (Gmail kappt > ~102 KB) */
    .st{border-collapse:collapse;width:100%;font-size:13px;font-family:'JetBrains Mono','SFMono-Regular',Consolas,monospace;font-variant-numeric:tabular-nums;}
    .st th{padding:8px 4px;border-bottom:1px solid rgba(232,168,32,0.18);font-size:10px;text-transform:uppercase;letter-spacing:0.06em;color:#a89878;font-weight:600;font-family:-apple-system,'Segoe UI',sans-serif;}
    .st th.hl{color:#e8a820;font-weight:700;border-bottom-color:rgba(232,168,32,0.30);}
    .st td{padding:9px 4px;font-size:12px;}
    .st tr.r{border-bottom:1px solid rgba(255,255,255,0.04);}
    .tk{font-weight:700;color:#e8a820;}
    .tk i{display:block;font-style:normal;font-size:10px;color:#a89878;font-weight:400;margin-top:2px;font-family:-apple-system,'Segoe UI',sans-serif;}
    .v{color:#e2e8f0;font-weight:600;}
    .up{color:#30e878;font-weight:700;}.dn{color:#ff6060;font-weight:700;}.nu{color:#a89878;}
    .w6{font-weight:600;}
    .rxh{color:#ff3b3b;}.rh{color:#ff8a6a;}.rxl{color:#2fe06a;}.rl{color:#8ad6a0;}
    .p{display:inline-block;min-width:30px;padding:3px 7px;border-radius:11px;font-size:12px;font-weight:800;}
    .pb{min-width:38px;padding:4px 9px;border-radius:12px;font-size:13px;font-weight:900;}
    .g1{background:rgba(48,232,120,0.20);color:#30e878;}
    .g2{background:rgba(48,232,120,0.10);color:#7fe0a0;}
    .go{background:rgba(232,168,32,0.16);color:#e8a820;}
    .gr{background:rgba(168,152,120,0.13);color:#a89878;}
    .rd{background:rgba(255,96,96,0.16);color:#ff6060;}
    .g0{background:rgba(48,232,120,0.28);color:#5cff9e;}
    /* „Warum"-Zeile unter Top-Picks */
    .st tr.wr td.why{padding:0 6px 9px;font-size:10px;line-height:1.5;color:#8a8270;font-family:-apple-system,'Segoe UI',sans-serif;letter-spacing:.1px;}
    .vd{display:inline-block;font-weight:700;font-size:9px;text-transform:uppercase;letter-spacing:.04em;padding:1px 6px;border-radius:7px;margin-right:2px;}
    .vd-strong{background:rgba(48,232,120,0.18);color:#30e878;}
    .vd-bull{background:rgba(232,168,32,0.16);color:#e8a820;}
    .vd-weak{background:rgba(168,152,120,0.14);color:#a89878;}
  </style>
</head>
<body style="margin:0;padding:0;background:#000000;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#e2e8f0;-webkit-font-smoothing:antialiased;">

<!-- Preheader -->
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
  Markt-Überblick · Top {{ etfs|length }} ETFs · {{ stocks|length }} Aktien · {{ events|length }} Events für {{ target_display }} · LBR/RSI-Score
</div>

{#
  ════════════════════════════════════════════════════════════════════
  MAKRO: Signal-Score-Tabelle
  (Ticker | Kurs | Δ Vt | SC | LBR W | LBR D | RSI D | RSI W | TS | Gesamt)
  Wiederverwendet von Kernliste, ETFs, Aktien, Watchlist.
  ════════════════════════════════════════════════════════════════════
#}
{% macro signal_table(rows, show_why=false) %}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="st">
    <thead><tr>
      <th align="left">Ticker</th>
      <th align="right">Kurs</th>
      <th align="right">Δ&nbsp;Vt</th>
      <th align="center" class="hl" title="Saisonal-Score (Multi-Window): wie viele von 4 historischen TDOM-Renditefenstern im Schnitt positiv waren (0–4)">SC</th>
      <th align="center" title="LBR-Oszillator Wochenbasis">LBR&nbsp;W</th>
      <th align="center" title="LBR-Oszillator Tagesbasis">LBR&nbsp;D</th>
      <th align="right" title="RSI Tagesbasis">RSI&nbsp;D</th>
      <th align="right" title="RSI Wochenbasis">RSI&nbsp;W</th>
      <th align="center" title="Technical Score (LBR/RSI), max 4">TS</th>
      <th align="center" class="hl" title="Gesamtscore = SC + TS (0–8), Sortierschlüssel">Gesamt</th>
    </tr></thead>
    <tbody>
      {% for r in rows %}
      <tr class="r">
        <td class="tk">{{ r.ticker }}{% if r.name %}<i>{{ r.name }}</i>{% endif %}</td>
        <td align="right" class="v">{% if r.price_close is not none %}{{ '%.2f' % r.price_close }}{% else %}—{% endif %}</td>
        <td align="right" class="w6 {{ 'up' if r.change_pct is not none and r.change_pct > 0 else 'dn' if r.change_pct is not none and r.change_pct < 0 else 'nu' }}">{% if r.change_pct is not none %}{{ '%+.2f' % r.change_pct }}%{% else %}—{% endif %}</td>
        <td align="center">{% if r.mw_score is not none %}<span class="p {{ 'g1' if r.mw_score >= 4 else 'g2' if r.mw_score == 3 else 'go' if r.mw_score == 2 else 'gr' }}">{{ r.mw_score }}/4</span>{% else %}<span class="nu">—</span>{% endif %}</td>
        <td align="center" class="{{ 'up' if r.lbr_weekly is not none and r.lbr_weekly > 0 else 'dn' if r.lbr_weekly is not none and r.lbr_weekly < 0 else 'nu' }}">{% if r.lbr_weekly is none %}—{% elif r.lbr_weekly > 0 %}▲{% elif r.lbr_weekly < 0 %}▼{% else %}•{% endif %}</td>
        <td align="center" class="{{ 'up' if r.lbr_daily is not none and r.lbr_daily > 0 else 'dn' if r.lbr_daily is not none and r.lbr_daily < 0 else 'nu' }}">{% if r.lbr_daily is none %}—{% elif r.lbr_daily > 0 %}▲{% elif r.lbr_daily < 0 %}▼{% else %}•{% endif %}</td>
        <td align="right" class="w6 {{ 'nu' if r.rsi_daily is none else 'rxh' if r.rsi_daily > 90 else 'rh' if r.rsi_daily > 70 else 'rxl' if r.rsi_daily < 10 else 'rl' if r.rsi_daily < 30 else 'nu' }}">{% if r.rsi_daily is not none %}{{ '%.0f' % r.rsi_daily }}{% else %}—{% endif %}</td>
        <td align="right" class="w6 {{ 'nu' if r.rsi_weekly is none else 'rxh' if r.rsi_weekly > 90 else 'rh' if r.rsi_weekly > 70 else 'rxl' if r.rsi_weekly < 10 else 'rl' if r.rsi_weekly < 30 else 'nu' }}">{% if r.rsi_weekly is not none %}{{ '%.0f' % r.rsi_weekly }}{% else %}—{% endif %}</td>
        <td align="center"><span class="p {{ 'g1' if r.score >= 3 else 'go' if r.score >= 1 else 'gr' if r.score == 0 else 'rd' }}">{{ '%+d' % r.score }}/4</span></td>
        <td align="center"><span class="p pb {{ 'g0' if r.total_score >= 6 else 'g1' if r.total_score >= 4 else 'go' if r.total_score >= 2 else 'gr' if r.total_score >= 0 else 'rd' }}">{{ '%+d' % r.total_score }}/8</span></td>
      </tr>
      {% if show_why and r.why %}
      <tr class="wr"><td colspan="10" class="why">
        <span class="vd vd-{{ r.why.verdict_class }}">{{ r.why.verdict }}</span> · SC {{ r.why.hits }}:
        {% for w in r.why.windows_compact %}{{ w.label }}&nbsp;<span class="{{ 'up' if w.hit else 'nu' }}">{{ w.pct }}</span>{% if not loop.last %} · {% endif %}{% endfor %}
        {% if r.why.win_rate_pct is not none %} · Trefferquote {{ r.why.win_rate_pct }}%{% endif %}
        {% if r.why.sample_n %} · n={{ r.why.sample_n }}{% endif %}
      </td></tr>
      {% endif %}
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#000000;">
<tr><td align="center" style="padding:24px 10px;">

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="720" style="max-width:720px;background:#0a0a0e;border:1px solid rgba(232,168,32,0.15);border-radius:12px;overflow:hidden;">

    <!-- ══════════════════════ HEADER ══════════════════════ -->
    <tr><td style="padding:28px 32px 20px;border-bottom:1px solid rgba(232,168,32,0.12);">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td style="vertical-align:middle;">
            <div style="font-family:'Sora',sans-serif;font-size:22px;font-weight:800;color:#ffffff;letter-spacing:-0.02em;">
              Season<span style="color:#e8a820;">Alpha</span>
            </div>
            <div style="font-size:11px;color:#a89878;text-transform:uppercase;letter-spacing:0.12em;margin-top:4px;">
              Morning Briefing
            </div>
          </td>
          <td align="right" style="vertical-align:middle;">
            <div style="font-size:12px;color:#a89878;">Nächster Handelstag</div>
            <div style="font-size:14px;color:#e2e8f0;font-weight:600;margin-top:2px;">{{ target_display }}</div>
            {% if target_tdom %}
            <div style="font-size:11px;color:#a89878;margin-top:2px;">TDOM {{ target_tdom }}</div>
            {% endif %}
          </td>
        </tr>
      </table>
    </td></tr>

    {% if status_line %}
    <!-- ══════════════════════ STATUS-LINE ══════════════════════ -->
    <tr><td style="padding:14px 32px 0;">
      <div style="font-family:'JetBrains Mono','SFMono-Regular',Consolas,monospace;font-size:12px;color:#e8a820;font-weight:600;letter-spacing:0.2px;padding:10px 12px;background:rgba(232,168,32,0.06);border-left:3px solid #e8a820;border-radius:0 6px 6px 0;font-variant-numeric:tabular-nums;">
        {{ status_line }}
      </div>
    </td></tr>
    {% endif %}

    <!-- ══════════════════════ INTRO ══════════════════════ -->
    <tr><td style="padding:22px 32px 8px;">
      <p style="margin:0;font-size:14px;line-height:1.6;color:#cbd5e1;">
        Saisonale Signale für den anstehenden Handelstag: Markt-Überblick, Top-Auswahl und Watchlist mit dem <strong style="color:#e8a820;">Saisonal-Score (MW&nbsp;0–4)</strong> sowie <strong style="color:#e8a820;">LBR/RSI</strong>-Momentum und kombiniertem Score, dazu Events und aktive Strategien.
      </p>
    </td></tr>

    {% if core_list %}
    <!-- ══════════════════════ SEKTION 1: KERNLISTE / MARKT-ÜBERBLICK ══════════════════════ -->
    <tr><td style="padding:24px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        🧭 Markt-Überblick
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Leitmärkte — LBR/RSI-Momentum und Gesamtscore als Markt-Kontext für den Tag.
      </div>
      {{ signal_table(core_list) }}
    </td></tr>
    {% endif %}

    {% if etfs %}
    <!-- ══════════════════════ SEKTION 2a: TOP-ETFs ══════════════════════ -->
    <tr><td style="padding:24px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        🎯 Top {{ etfs|length }} ETFs
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Score-stärkste ETFs für den anstehenden Handelstag (TDOM {{ target_tdom }}).
      </div>
      {{ signal_table(etfs, show_why=true) }}
    </td></tr>
    {% endif %}

    {% if stocks %}
    <!-- ══════════════════════ SEKTION 2b: TOP-AKTIEN ══════════════════════ -->
    <tr><td style="padding:18px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        💼 Top {{ stocks|length }} Aktien
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Score-stärkste Einzelwerte aus US- und EU-Universum.
      </div>
      {{ signal_table(stocks, show_why=true) }}
    </td></tr>
    {% endif %}

    {% if not etfs and not stocks %}
    <tr><td style="padding:24px 32px 8px;">
      <div style="padding:16px;background:rgba(255,64,64,0.06);border:1px solid rgba(255,64,64,0.2);border-radius:8px;color:#ff6b6b;font-size:13px;line-height:1.6;">
        ⚠️ Keine Top-Auswahl für heute — die saisonalen LBR/RSI-Signale sind aktuell nicht ausreichend stark.
      </div>
    </td></tr>
    {% endif %}

    {% set month_names = {1:'Januar',2:'Februar',3:'März',4:'April',5:'Mai',6:'Juni',7:'Juli',8:'August',9:'September',10:'Oktober',11:'November',12:'Dezember'} %}
    {% if rotation and (rotation.current_top or rotation.next_top) %}
    <!-- ══════════════════════ SEKTION: SEKTOR-ROTATION ══════════════════════ -->
    <tr><td style="padding:24px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        🔄 Sektor-Rotation
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Saisonal stärkste Sektor-ETFs — aktueller Monat und Folgemonat im Vergleich
      </div>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
        <tr>
          {# ── Aktueller Monat ── #}
          <td width="50%" valign="top" style="padding:0 8px 0 0;">
            <div style="font-size:11px;color:#e8a820;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;margin-bottom:8px;">
              {{ month_names.get(rotation.current_month, rotation.current_month) }}
            </div>
            {% for s in rotation.current_top %}
            <div style="padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:13px;">
              <span style="color:#e8a820;font-family:'JetBrains Mono',monospace;font-weight:700;">{{ s.ticker }}</span>
              <span style="color:#cbd5e1;margin-left:6px;">{{ s.name }}</span>
              <span style="color:#30e878;float:right;font-variant-numeric:tabular-nums;font-weight:600;">+{{ '%.1f' % s.avg_return_pct }}%</span>
            </div>
            {% endfor %}
          </td>
          {# ── Folgemonat ── #}
          <td width="50%" valign="top" style="padding:0 0 0 8px;border-left:1px solid rgba(232,168,32,0.10);">
            <div style="font-size:11px;color:#e8a820;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;margin-bottom:8px;">
              {{ month_names.get(rotation.next_month, rotation.next_month) }} <span style="color:#a89878;font-weight:400;">(Folgemonat)</span>
            </div>
            {% for s in rotation.next_top %}
            <div style="padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:13px;">
              <span style="color:#e8a820;font-family:'JetBrains Mono',monospace;font-weight:700;">{{ s.ticker }}</span>
              <span style="color:#cbd5e1;margin-left:6px;">{{ s.name }}</span>
              <span style="color:#30e878;float:right;font-variant-numeric:tabular-nums;font-weight:600;">+{{ '%.1f' % s.avg_return_pct }}%</span>
            </div>
            {% endfor %}
          </td>
        </tr>
      </table>
      {% if rotation.legend %}
      <div style="margin-top:12px;font-size:11px;color:#a89878;line-height:1.7;">
        {% for l in rotation.legend %}<span style="color:#e8a820;font-family:'JetBrains Mono',monospace;">{{ l.ticker }}</span> = {{ l.name }}{% if not loop.last %} &middot; {% endif %}{% endfor %}
      </div>
      {% endif %}
    </td></tr>
    {% endif %}

    {% if watchlist %}
    <!-- ══════════════════════ SEKTION 2c: WATCHLIST ══════════════════════ -->
    <tr><td style="padding:24px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        ⭐ Deine Watchlist ({{ watchlist|length }})
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Deine persönlich beobachteten Werte — score-sortiert mit denselben LBR/RSI-Signalen.
      </div>
      {{ signal_table(watchlist) }}
      <div style="margin-top:10px;font-size:11px;color:#a89878;text-align:right;">
        <a href="https://seasonalpha.ai/watchlist" style="color:#e8a820;text-decoration:none;">Watchlist verwalten →</a>
      </div>
    </td></tr>
    {% endif %}

    <!-- ══════════════════════ SCORE-FUSSNOTE ══════════════════════ -->
    <tr><td style="padding:14px 32px 8px;">
      <div style="padding:12px 14px;background:rgba(168,152,120,0.05);border:1px solid rgba(168,152,120,0.14);border-radius:8px;">
        <div style="font-size:11px;color:#a89878;line-height:1.65;">
          <strong style="color:#e8a820;">SC &mdash; Saisonal-Score (0&ndash;4)</strong>: wie viele von vier historischen Renditefenstern auf dem heutigen Handelstag des Monats (TDOM) im Schnitt positiv waren &mdash;
          ① Open&rarr;Close · ② Open&rarr;Open(t+1) · ③ Open&rarr;Close(t+1) · ④ Close&rarr;Close(t+1).
          <strong style="color:#cbd5e1;">4/4</strong> = alle Fenster historisch im Plus · <strong style="color:#cbd5e1;">3/4</strong> robust positiv · <strong style="color:#cbd5e1;">≤2</strong> mehrdeutig. Börsenspezifische TDOM je Ticker.
          <br>Die <strong style="color:#cbd5e1;">„Warum"-Zeile</strong> unter jedem Top-Pick zeigt die vier Fenster einzeln (O&rarr;C = Open&rarr;Close, O&rarr;O⁺/O&rarr;C⁺/C&rarr;C⁺ = bis zum Folgetag), die historische Trefferquote und <strong style="color:#cbd5e1;">n</strong> = Stichprobengröße (Anzahl historischer Vorkommen dieses TDOM).
          <br><br>
          <strong style="color:#e8a820;">TS &mdash; Technical Score (max&nbsp;4)</strong> = Summe folgender LBR/RSI-Bedingungen:
          <br>· LBR weekly &gt; 0 &rarr; +1
          <br>· LBR daily &gt; 0 &rarr; +1
          <br>· RSI weekly &gt; 50 &rarr; +1
          <br>· RSI daily &gt; 90 <em>und</em> RSI weekly &gt; 90 &rarr; &minus;1 (beide extrem überkauft)
          <br>· RSI daily &lt; 10 <em>und</em> RSI weekly &lt; 10 &rarr; +1 (beide extrem überverkauft)
          <br><br>
          <strong style="color:#cbd5e1;">LBR</strong> = Linda-Bradford-Raschke-Oszillator (3-10), misst Momentum/Trend &mdash; <span style="color:#30e878;">▲ &gt;0 bullish</span>, <span style="color:#ff6060;">▼ &lt;0 bearish</span>.
          <strong style="color:#cbd5e1;">RSI</strong> = Relative-Stärke-Index (0&ndash;100); &gt;70 überkauft, &lt;30 überverkauft.
          <br><br>
          <strong style="color:#e8a820;">Gesamt (0&ndash;8)</strong> = SC + TS &mdash; die zusammengefasste Tageskennzahl, nach der die Listen absteigend sortiert sind.
          <br><br>
          Analyse &amp; Bildung &mdash; keine Anlageberatung.
        </div>
      </div>
    </td></tr>

    {% if events %}
    <!-- ══════════════════════ SEKTION 3: EVENTS ══════════════════════ -->
    <tr><td style="padding:24px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        📅 Events der nächsten 5 Tage
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Marktrelevante Termine — FOMC, OPEX, Earnings, Dividenden, Feiertage
      </div>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-size:13px;">
        {% for ev in events %}
        <tr>
          <td style="padding:8px 6px;color:#cbd5e1;border-bottom:1px solid rgba(255,255,255,0.04);">
            <span style="margin-right:8px;">{{ ev.emoji }}</span>
            <strong style="color:#e2e8f0;">{{ ev.name }}</strong>
            <span style="color:#a89878;font-size:11px;margin-left:8px;">· {{ ev.date }}</span>
          </td>
        </tr>
        {% endfor %}
      </table>
    </td></tr>
    {% endif %}

    <!-- ══════════════════════ SEKTION 4: AKTIVE STRATEGIEN ══════════════════════ -->
    <tr><td style="padding:24px 32px 8px;">
      <div style="font-family:'Sora',sans-serif;font-size:16px;font-weight:700;color:#e8a820;margin-bottom:4px;">
        ⚙️ Aktive Saisonal-Strategien
      </div>
      <div style="font-size:12px;color:#a89878;margin-bottom:14px;">
        Welche Strategien befinden sich heute im Entry-/Long-Fenster
      </div>
      {% if strategies %}
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-size:13px;">
        {% for s in strategies %}
        <tr>
          <td style="padding:10px 6px;border-bottom:1px solid rgba(255,255,255,0.04);">
            <div style="color:#e2e8f0;font-weight:600;">
              {{ s.name }}
              <span style="color:#e8a820;font-size:11px;margin-left:6px;">[{{ s.ticker }}]</span>
              <span style="color:#a89878;font-size:11px;margin-left:6px;">{{ s.phase }}</span>
            </div>
            <div style="color:#a89878;font-size:12px;margin-top:3px;line-height:1.5;">
              {{ s.description }}
            </div>
          </td>
        </tr>
        {% endfor %}
      </table>
      {% else %}
      <div style="padding:14px;background:rgba(168,152,120,0.06);border-left:3px solid rgba(168,152,120,0.4);border-radius:0 6px 6px 0;color:#a89878;font-size:13px;line-height:1.6;">
        Aktuell keine spezifische saisonale Strategie im Entry-Fenster. Ruhige Phase — Markt-Überblick und Score sind die wichtigsten Signale.
      </div>
      {% endif %}
    </td></tr>

    <!-- ══════════════════════ CTA ══════════════════════ -->
