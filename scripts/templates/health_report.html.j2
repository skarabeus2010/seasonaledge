<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SeasonAlpha Health Report</title>
</head>
<body style="margin:0;padding:0;background:#0a0a0e;color:#e8e8e8;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#0a0a0e;padding:24px 12px;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background:#13131a;border:1px solid #2a2a35;border-radius:12px;overflow:hidden;">

        {# ── Header mit Ampel ── #}
        {% set header_bg = {
          'green':  '#0f2a1a',
          'yellow': '#2a240f',
          'red':    '#2a0f0f'
        }[overall_status] %}
        {% set header_color = {
          'green':  '#22c55e',
          'yellow': '#eab308',
          'red':    '#ef4444'
        }[overall_status] %}
        {% set header_label = {
          'green':  'ALLE SYSTEME GRÜN',
          'yellow': 'WARNUNG — 1+ JOB HAKT',
          'red':    'FEHLER — HANDLUNG NÖTIG'
        }[overall_status] %}
        {% set header_icon = {
          'green':  '✓',
          'yellow': '!',
          'red':    '✗'
        }[overall_status] %}

        <tr>
          <td style="background:{{ header_bg }};padding:24px 28px;border-bottom:2px solid {{ header_color }};">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="vertical-align:middle;">
                  <div style="font-size:11px;font-weight:600;letter-spacing:2px;color:#9ca3af;text-transform:uppercase;margin-bottom:4px;">
                    SeasonAlpha Health Check
                  </div>
                  <div style="font-size:22px;font-weight:700;color:{{ header_color }};line-height:1.2;">
                    {{ header_icon }} {{ header_label }}
                  </div>
                  <div style="font-size:13px;color:#9ca3af;margin-top:6px;">
                    {{ report_time }}
                  </div>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {# ── Checks-Tabelle ── #}
        <tr>
          <td style="padding:20px 28px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              {% for check in checks %}
              {% set row_color = {
                'green':  '#22c55e',
                'yellow': '#eab308',
                'red':    '#ef4444'
              }[check.status] %}
              {% set row_icon = {
                'green':  '✓',
                'yellow': '!',
                'red':    '✗'
              }[check.status] %}
              <tr>
                <td style="padding:10px 0;border-bottom:1px solid #1f1f29;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="24" style="vertical-align:top;">
                        <div style="width:20px;height:20px;border-radius:50%;background:{{ row_color }}22;border:1.5px solid {{ row_color }};color:{{ row_color }};text-align:center;line-height:17px;font-size:12px;font-weight:700;">
                          {{ row_icon }}
                        </div>
                      </td>
                      <td style="padding-left:12px;vertical-align:top;">
                        <div style="font-size:14px;font-weight:600;color:#e8e8e8;margin-bottom:2px;">
                          {{ check.name }}
                        </div>
                        <div style="font-size:12px;color:#9ca3af;line-height:1.5;">
                          {{ check.detail }}
                        </div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        {# ── Handlungsempfehlung bei Problemen ── #}
        {% if overall_status != 'green' %}
        <tr>
          <td style="padding:0 28px 20px;">
            <div style="background:#1a1a23;border:1px solid #2a2a35;border-radius:8px;padding:16px;">
              <div style="font-size:12px;font-weight:600;color:#e8a820;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">
                Quick-Diagnose
              </div>
              <div style="font-size:13px;color:#d4d4d8;line-height:1.6;">
                1. GitHub Actions pruefen:
                <a href="https://github.com/skarabeus2010/seasonaledge/actions" style="color:#e8a820;text-decoration:none;">
                  github.com/skarabeus2010/seasonaledge/actions
                </a><br>
                2. Server-Log: <code style="background:#0a0a0e;color:#e8a820;padding:2px 6px;border-radius:4px;font-family:monospace;font-size:12px;">ssh root@178.104.75.46</code><br>
                3. Manueller Nightly:
                <code style="background:#0a0a0e;color:#e8a820;padding:2px 6px;border-radius:4px;font-family:monospace;font-size:12px;">docker exec seasonalpha-app python3 scripts/nightly_refresh.py</code>
              </div>
            </div>
          </td>
        </tr>
        {% endif %}

        {# ── Standing-Text: Selbst testen (immer sichtbar) ── #}
        <tr>
          <td style="padding:0 28px 20px;">
            <div style="background:#0f1016;border:1px solid #1f1f29;border-radius:8px;padding:16px;">
              <div style="font-size:12px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;">
                Selbst testen
              </div>
              <div style="font-size:12px;color:#d4d4d8;line-height:1.7;">
                <strong style="color:#e8a820;">GitHub Actions (ohne SSH):</strong><br>
                <a href="https://github.com/skarabeus2010/seasonaledge/actions/workflows/daily_health.yml" style="color:#9ca3af;text-decoration:none;">&rsaquo; Daily Health Check</a> &mdash; Run workflow&nbsp; (diese Mail erneut ausloesen)<br>
                <a href="https://github.com/skarabeus2010/seasonaledge/actions/workflows/weekly_newsletter_manual.yml" style="color:#9ca3af;text-decoration:none;">&rsaquo; Weekly Newsletter (Manual Trigger)</a> &mdash; Dropdown <em>test</em>/<em>dry-run</em>/<em>live</em>
                <br><br>
                <strong style="color:#e8a820;">Server (SSH):</strong>
                <pre style="background:#0a0a0e;color:#d4d4d8;padding:10px;border-radius:6px;font-family:monospace;font-size:11px;margin:6px 0;white-space:pre-wrap;">ssh root@178.104.75.46

# Health-Mail erneut senden
docker exec seasonalpha-app python3 scripts/daily_health_check.py

# Weekly-Newsletter Test (nur an ADMIN_EMAIL)
docker exec seasonalpha-app python3 scripts/weekly_newsletter.py --test

# Weekly-Newsletter Preview ohne Versand
docker exec seasonalpha-app python3 scripts/weekly_newsletter.py --dry-run

# Daten-Freshness: letzter Nightly-Eintrag
docker exec seasonalpha-app python3 -c "from shared.supabase_client import get_client; print(get_client().table('refresh_log').select('run_date,duration_seconds,errors').order('created_at',desc=True).limit(1).execute().data)"</pre>
                <strong style="color:#e8a820;">Brevo-Zustellstatus:</strong>
                <a href="https://app.brevo.com/statistics/email" style="color:#9ca3af;text-decoration:none;">app.brevo.com/statistics/email</a>
                &mdash; nach <code style="font-family:monospace;font-size:11px;">messageId</code> aus dem Script-Log filtern
                <br><br>
                <strong style="color:#e8a820;">Doku:</strong>
                <a href="https://github.com/skarabeus2010/seasonaledge/blob/master/docs/EMAIL_TESTING.md" style="color:#9ca3af;text-decoration:none;">docs/EMAIL_TESTING.md</a>
                &mdash; Troubleshooting, Key-Rotation, Sender-Domain
              </div>
            </div>
          </td>
        </tr>

        {# ── Footer ── #}
        <tr>
          <td style="background:#0a0a0e;padding:16px 28px;border-top:1px solid #2a2a35;">
            <div style="font-size:11px;color:#6b7280;line-height:1.6;text-align:center;">
              Automatischer Health-Check · <a href="https://seasonalpha.ai" style="color:#6b7280;text-decoration:none;">seasonalpha.ai</a><br>
              Taeglich 07:00 UTC via GitHub Action
            </div>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
