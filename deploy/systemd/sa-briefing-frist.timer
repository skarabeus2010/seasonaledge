[Unit]
Description=SeasonAlpha Fristpruefung Daily Briefing Mo-Fr 10:15 Berliner Zeit

[Timer]
# Das Briefing kommt um 07:30 Berliner Zeit (sa-daily-briefing.timer). Die Health-Mail (05:00 UTC) liegt davor und
# kann die Frist nicht pruefen; diese Pruefung schickt nur bei Verstoss einen Admin-Alarm.
OnCalendar=Mon..Fri *-*-* 10:15:00 Europe/Berlin
AccuracySec=1min
# Nicht nachholen: eine spaete Fristpruefung nach einem Serverausfall waere ein Fehlalarm ohne Aussage.
Persistent=false
Unit=sa-briefing-frist.service

[Install]
WantedBy=timers.target
