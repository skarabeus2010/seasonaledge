# SeasonAlpha — Daily Morning Briefing (Mo–Fr, ausgeloest von sa-daily-briefing.timer).
# Ersetzt den GitHub-Cron in daily_newsletter.yml: GitHub startete '0 6 * * 1-5' in der Woche vom 05.10.2026
# erst zwischen 11:48 und 14:18 UTC — das "Morning" Briefing kam am Nachmittag an.
# Installation/Aktualisierung: deploy/install_timers.sh (laeuft im Deploy).

[Unit]
Description=SeasonAlpha Daily Morning Briefing
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
# Nach einem Deploy kann der Container gerade neu erstellt werden: begrenzt warten.
ExecStartPre=/bin/bash /opt/seasonaledge/deploy/systemd/warte_auf_app.sh
# Der Timeout sitzt IM Container: systemd beendet bei TimeoutStartSec nur den docker-Client, nicht den Prozess
# im Container. `timeout` begrenzt den Python-Lauf selbst (15 min + 30 s Kill), das aeussere Limit liegt darueber.
# Ohne Argumente = produktiver Versand an alle Abonnenten (wie der bisherige Zeitplan). Test- und Trockenlaeufe
# bleiben ueber den manuellen GitHub-Dispatch (daily_newsletter.yml) moeglich.
ExecStart=/usr/bin/docker exec seasonalpha-app timeout --kill-after=30s 15m python3 -u scripts/daily_newsletter.py
TimeoutStartSec=18min
# Exit 75 = Produktionssperre (Kalender-Aktivierung, shared/produktionssperre.py): geplant unterdrueckt, kein Fehler.
# Nachweis: refresh_log run_type=produktionssperre + logs/sperre/unterdrueckt.log. Jeder andere Exit bleibt ein Fehler.
SuccessExitStatus=75
